<?xml version="1.0" encoding="utf-8"?>
<!-- Android has blocked plaintext HTTP by default since API 28, and that
     includes loopback. The server this app hosts is plain HTTP on 127.0.0.1,
     so without this exception the WebView renders nothing at all and says very
     little about why. Only loopback is exempted: everything else stays blocked. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
